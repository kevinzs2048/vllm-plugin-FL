# Source this file in Bash on the P1 host, outside Docker.
# It sets paths and operator selection only; it does not run model inference.
_workshop_activate_host() {
    local script_dir root item
    if [ -f /.dockerenv ]; then
        printf '%s\n' 'ERROR: run this host step outside Docker. Container paths are /work and /model.' >&2
        return 1
    fi
    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || return 1
    root=$(cd -- "$script_dir/.." && pwd) || return 1
    if [ -n "${WORK_ROOT:-}" ] && [ "$(cd -- "$WORK_ROOT" 2>/dev/null && pwd)" != "$root" ]; then
        printf 'ERROR: WORK_ROOT=%s differs from the script directory root %s.\n' "$WORK_ROOT" "$root" >&2
        return 1
    fi
    for item in check_preloaded.sh release.env triton-tle.env init_container.sh start_service.sh; do
        if [ ! -f "$script_dir/$item" ]; then
            printf 'ERROR: missing %s. Extract the online Workshop helper package into %s first.\n' "$script_dir/$item" "$root" >&2
            return 1
        fi
    done
    export WORK_ROOT="$root"
    export MODEL_DIR="$WORK_ROOT/models/MiniCPM-V-4.7-1B-W8A8-FlagOS"
    source "$script_dir/release.env" || return 1
    source "$script_dir/triton-tle.env" || return 1
    printf 'Host paths ready: WORK_ROOT=%s MODEL_DIR=%s backend=%s\n' "$WORK_ROOT" "$MODEL_DIR" "$FL_ARM_OPERATOR_BACKEND"
}
if _workshop_activate_host; then
    unset -f _workshop_activate_host
else
    unset -f _workshop_activate_host
    return 1
fi
